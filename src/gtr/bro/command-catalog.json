{
  "version": "1.0.0",
  "product": "iPhuket/GTR",
  "language": "ru",
  "rules": {
    "default_max_spoken_sentences": 2,
    "one_clarifying_question_at_a_time": true,
    "current_facts_require_tool_result": true,
    "paid_actions_require_ui_confirmation": true,
    "voice_yes_never_confirms_payment": true,
    "default_persona": "bro",
    "out_of_domain_behavior": "brief_redirect_to_product"
  },
  "commands": [
    {
      "id": "CMD-SESSION-001",
      "group": "session",
      "intent": "stop_speaking",
      "examples": ["Стоп", "Тихо", "Хватит говорить", "Я тебя перебью"],
      "execution": "local",
      "handler": "audio.stopPlayback",
      "confirmation": "none",
      "spoken_ack": "none",
      "latency_class": "instant"
    },
    {
      "id": "CMD-SESSION-002",
      "group": "session",
      "intent": "repeat_last",
      "examples": ["Повтори", "Что ты сказал?", "Ещё раз", "Не расслышал"],
      "execution": "local",
      "handler": "session.repeatLastSpeech",
      "confirmation": "none",
      "voice_style": "confirmation",
      "latency_class": "instant"
    },
    {
      "id": "CMD-SESSION-003",
      "group": "session",
      "intent": "make_shorter",
      "examples": ["Короче", "Покороче давай", "Без лишнего", "Одним предложением"],
      "execution": "local",
      "handler": "session.setVerbosity",
      "arguments": {"verbosity": "minimal"},
      "confirmation": "none",
      "voice_style": "confirmation",
      "latency_class": "instant"
    },
    {
      "id": "CMD-SESSION-004",
      "group": "session",
      "intent": "more_details",
      "examples": ["Подробнее", "Расскажи больше", "А детали?", "Что там конкретно?"],
      "execution": "contextual",
      "handler": "session.expandCurrentResult",
      "confirmation": "none",
      "voice_style": "neutral_bro",
      "latency_class": "fast"
    },
    {
      "id": "CMD-SESSION-005",
      "group": "session",
      "intent": "go_back",
      "examples": ["Назад", "Вернись", "Предыдущий экран", "Давай обратно"],
      "execution": "local",
      "handler": "navigation.back",
      "confirmation": "none",
      "spoken_ack": "none",
      "latency_class": "instant"
    },
    {
      "id": "CMD-SESSION-006",
      "group": "session",
      "intent": "close_assistant",
      "examples": ["Закройся", "До связи", "Выключайся", "Хватит на сегодня"],
      "execution": "local",
      "handler": "session.close",
      "confirmation": "none",
