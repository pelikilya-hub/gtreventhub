// «Моя радуга» — сервер: один воркер + один Durable Object на всю компанию.
// Отдельный воркер, с gtr-event-hub из корня репозитория никак не связан.
{
  "name": "moya-raduga",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Адреса предпросмотра версий не нужны: наружу смотрит только основной.
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "moya-raduga-media" }],
  "vars": {
    // Сколько «чудес» (генераций) в сутки на одного ребёнка.
    "MAGIC_DAILY_LIMIT": "10",
    // Модель картинок OpenAI. Нужна с прозрачным фоном: маски и стикеры без него не работают.
    "MAGIC_MODEL": "gpt-image-1.5"
  }
  // Секреты (wrangler secret put): MEMBERS — JSON со списком участников,
  // OPENAI_API_KEY — ключ для генерации.
}
