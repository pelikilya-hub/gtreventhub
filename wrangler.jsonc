// Источник истины деплой-конфига воркера.
//
// Nitro (пресет cloudflare_module) находит этот файл в корне и вливает его
// в генерируемый .output/server/wrangler.json при КАЖДОЙ сборке. Поэтому
// любой путь деплоя — ручной `npm run deploy:cf` или автосборка Cloudflare
// Workers Builds — получает биндинг KV, имя воркера и кроны.
//
// Урок 18.08.2026: автодеплой собрал воркер без пост-патча, и прод уехал
// без GTR_KV — упали вход, регистрация и BRO. Конфиг, который «доклеивается
// скриптом после сборки», существует только на той машине, где скрипт
// запустили. Этот файл — в репозитории, его теряет только git.
{
  "name": "gtr-event-hub",
  // Фиксированная дата совместимости: раньше подставлялась дата сборки,
  // и каждый деплой молча переезжал на новое поведение рантайма.
  // Менять — осознанно, отдельным коммитом. Минимум 2025-04-01: с неё
  // воркер наполняет process.env (см. DEPLOY.md).
  "compatibility_date": "2026-08-01",
  "kv_namespaces": [
    { "binding": "GTR_KV", "id": "a26fc466919d43e4a2e684d8765810b8" }
  ],
  // Собственный домен. custom_domain означает «воркер и есть источник»:
  // Cloudflare сам заводит DNS-запись и сертификат, руками в панели
  // ничего делать не нужно. Домен зарегистрирован в том же аккаунте,
  // его NS уже указывают на Cloudflare — иначе привязка бы не прошла.
  //
  // Технический адрес *.workers.dev остаётся рабочим: на нём висит
  // вебхук телеграма и он выручает, если с доменом что-то случится.
  "routes": [
    { "pattern": "gtrevent.com", "custom_domain": true },
    { "pattern": "www.gtrevent.com", "custom_domain": true }
  ],
  // Кроны: афиши каждые 2 часа; 13:00 UTC отчёт спринта; 10:00 UTC дайджест
  // комьюнити; 02:00 UTC сверка цен вилл; 04:00 UTC обучение BRO;
  // каждые 15 минут — сторож мозга BOSS.
  // Обработчик — хук cloudflare:scheduled в src/server/perimeter.ts.
  "triggers": {
    "crons": [
      "0 */2 * * *",
      "0 13 * * *",
      "0 10 * * *",
      "0 2 * * *",
      "0 4 * * *",
      "*/15 * * * *"
    ]
  }
}
