# Уведомления GTR о новых заявках организаторов.
# Скопируйте в .env и заполните. Реальные значения в git не коммитятся.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Чат для уведомлений: id менеджера или группы.
# Узнать: написать боту любое сообщение и открыть
# https://api.telegram.org/bot<ТОКЕН>/getUpdates — id будет в result[].message.chat.id
# У групп id отрицательный, например -1001234567890
TELEGRAM_CHAT_ID=

# Пароль доступа к админке на публичном стенде.
# Если не задан — работает демо-режим: пароль gtr2026 и кнопки быстрого
# входа прямо на экране входа (годится только для локальной разработки).
GTR_ACCESS_PASSWORD=

# Подпись сессионной cookie. На проде задать обязательно.
GTR_SESSION_SECRET=
